@page
@model UserInputs.Pages.MyPages.QueryStringMultipleModel

<h1>Student Info System - Multiple Query String Values</h1>

<div>
    <p>Enter your information:</p>

    <form method="post">
        <label for="studentName">Name:</label>
        <input id="studentName"
               name="studentName"
               type="text"
               class="form-control input-group-lg" />

        <label for="studentId">Student Number:</label>
        <input id="studentId"
               name="studentId"
               type="text"
               class="form-control input-group-lg" />

        <input type="submit"
               value="Submit"
               class="btn btn-info" />
    </form>
</div>