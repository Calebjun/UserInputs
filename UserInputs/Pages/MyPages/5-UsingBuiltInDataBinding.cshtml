@page
@model UserInputs.Pages.MyPages.UsingBuiltInDataBindingModel

<h1>Student Info System - Handler Parameter Binding</h1>

<div>
    <p>Enter your information:</p>

    <form method="post">
        @* These names match the OnPost parameter names. *@
        <label for="studentName">Name:</label>
        <input id="studentName"
               name="studentName"
               type="text"
               class="form-control input-group-lg" />

        <label for="studentId">Student Number:</label>
        <input id="studentId"
               name="studentId"
               type="text"
               class="form-control input-group-lg" />

        <input type="submit"
               value="Submit"
               class="btn btn-info" />
    </form>
</div>

<div>
    <h2>Student Information Received</h2>
    <p>@ViewData["stdData"]</p>
</div>