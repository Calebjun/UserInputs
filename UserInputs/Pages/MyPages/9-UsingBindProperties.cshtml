@page
@model UserInputs.Pages.MyPages.UsingBindPropertiesModel

<h1>Student Info System - Using BindProperties</h1>

<div>
    <p>Enter your information:</p>

    <form method="post">
        @* Input names match the PageModel property names. *@
        <label for="studentName">Name:</label>
        <input id="studentName"
               name="studentName"
               type="text"
               class="form-control input-group-lg" />

        <label for="studentId">Student Number:</label>
        <input id="studentId"
               name="studentId"
               type="text"
               class="form-control input-group-lg" />

        <input type="submit"
               value="Submit"
               class="btn btn-info" />
    </form>
</div>

<div>
    <h2>Student Information Received</h2>
    <p>@ViewData["stdData"]</p>
</div>