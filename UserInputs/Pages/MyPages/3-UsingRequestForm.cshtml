@page
@model UserInputs.Pages.MyPages.UsingRequestFormModel

<h1>Student Info System - Using Request.Form</h1>

<div>
    <p>Enter your information:</p>

    @* POST places submitted field values in Request.Form. *@
    <form method="post">
        <label for="studentName">Name:</label>
        <input id="studentName"
               name="studentName"
               type="text"
               class="form-control input-group-lg" />

        <label for="studentId">Student Number:</label>
        <input id="studentId"
               name="studentId"
               type="text"
               class="form-control input-group-lg" />

        <input type="submit"
               value="Submit"
               class="btn btn-info" />
    </form>
</div>

<div>
    <h2>Student Information Received</h2>

    @* ViewData contains the result prepared in the PageModel. *@
    <p>@ViewData["stdData"]</p>
</div>